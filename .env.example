# Copy to .env (or export in your shell) before running.
# Secrets are read ONLY from environment variables — never from files in
# the repo.
ANTHROPIC_API_KEY=sk-ant-...

# Required for any shared/deployed instance: visitors must enter this
# code on the lock screen before using the app.
GRACE_ACCESS_CODE=choose-a-passcode

# Where church_profile.json and grace_usage.json are stored. On Railway,
# set this to your volume's mount path (e.g. /data). Unset = project dir.
# DATA_DIR=/data

# Optional overrides
# GRACE_MODEL=claude-sonnet-5
# GRACE_MAX_TOKENS=4096
# GRACE_SERVICE_BUILDER_MAX_TOKENS=12288
# PORT=5000
